{
  "name": "athena-robinhood-chain",
  "version": "1.0.0",
  "description": "Autonomous Multi-Agent Crypto Intelligence & Trading Ecosystem for Robinhood Chain (EVM)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "athena": "./bin/athena.js"
  },
  "scripts": {
    "athena": "node ./bin/athena.js",
    "wizard": "node scripts/wizard.js",
    "config": "node scripts/wizard.js",
    "dev": "tsx watch src/index.ts",
    "terminal": "tsx src/cli/tui.ts",
    "tui": "tsx src/cli/tui.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "npm install && npm run build && (npx pm2 delete athena-agent || true) && npx pm2 start dist/index.js --name athena-agent --update-env",
    "update": "node scripts/update-core.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "robinhood-chain",
    "evm",
    "crypto",
    "ai-agent",
    "discord-bot",
    "trading-bot",
    "robinhood-l2",
    "perps",
    "nft"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
