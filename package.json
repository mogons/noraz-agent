{
  "name": "athena-ai",
  "version": "1.0.0",
  "description": "Autonomous Multi-Agent Crypto Intelligence & Trading System operated via Discord Command Center",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "athena": "./bin/athena.js"
  },
  "scripts": {
    "athena": "node ./bin/athena.js",
    "wizard": "node scripts/wizard.js",
    "config": "node scripts/wizard.js",
    "dev": "tsx watch src/index.ts",
    "terminal": "tsx src/cli/tui.ts",
    "tui": "tsx src/cli/tui.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "npm install && npm run build && (npx pm2 delete athena-agent || true) && npx pm2 start dist/index.js --name athena-agent --update-env",
    "update": "git pull && npm install && npm run build && (npx pm2 delete athena-agent || true) && npx pm2 start dist/index.js --name athena-agent --update-env",
    "test": "vitest run"
  },
  "keywords": [
    "solana",
    "evm",
    "crypto",
    "ai-agent",
    "discord-bot",
    "trading-bot",
    "perps",
    "nft"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@jup-ag/api": "^6.0.30",
    "@meteora-ag/dlmm": "^1.4.0",
    "@opensea/sdk": "^11.7.2",
    "@opensea/stream-js": "^0.3.0",
    "@solana/web3.js": "^1.98.0",
    "@uniswap/sdk-core": "^5.8.0",
    "@uniswap/v3-sdk": "^3.22.0",
    "ccxt": "^4.4.60",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "pino": "^9.6.0",
    "viem": "^2.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
