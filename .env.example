# Environment Variables Configuration for Athena Crypto Agent
# Copy this file to .env and fill in your credentials. NEVER commit .env.

# ─── General Setup ───────────────────────────────────────────────────────────
DRY_RUN=true                                  # true = safe simulation (default); false = LIVE TRADING
SCREENING_TIMEOUT_MS=60000                     # per-agent pass timeout (ms); stuck pass resolves to [] (fail-closed)

# ─── Discord Credentials ─────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CHANNEL_CONTROL_ROOM=000000000000000000   # #athena-control-room (command center)

# ─── Telegram Credentials (Optional — dual-platform) ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Blockchain RPC Endpoints ────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EVM_RPC_URL=https://eth.llamarpc.com          # default EVM RPC (used if per-chain URLs are unset)
EVM_ETH_RPC_URL=https://eth.llamarpc.com
EVM_BASE_RPC_URL=https://mainnet.base.org
EVM_ROBINHOOD_RPC_URL=https://rpc.robinhood.com
# RPC failover pool (JSON): {"solana": ["url1","url2"], "evm": ["url1"]}
RPC_FAILOVER_URLS={}

# ─── AI Engine (stackable keys + per-key provider failover) ──────────────────
AI_PROVIDER=openrouter                      # 'openrouter' | 'openai' | 'anthropic' | 'custom'
AI_BASE_URL=https://openrouter.ai/api/v1    # custom endpoint base URL
AI_API_KEYS=key_primary_123,key_backup_456  # comma-separated — automatic backup failover
AI_API_KEY=your_llm_api_key_here
AI_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
# Per-key provider overrides (slot 2+): AI_KEY_<N>_PROVIDER / _BASE_URL / _MODEL_NAME
AI_KEY_2_PROVIDER=
AI_KEY_2_BASE_URL=
AI_KEY_2_MODEL_NAME=
AI_KEY_3_PROVIDER=
AI_KEY_3_BASE_URL=
AI_KEY_3_MODEL_NAME=

# ─── Market Intelligence & Security APIs ─────────────────────────────────────
TWEX_API_KEY=your_twex_api_key_here           # X/Twitter scraping (ct-alpha agent)
TWITTER_BEARER_TOKEN=                         # alternative Twitter API bearer
GMGN_API_KEY=your_gmgn_api_key_here           # GMGN OpenAPI (meme agents + token audit)
OPENSEA_API_KEY=your_opensea_api_key_here     # NFT floor/rarity (nft agent)
GOPLUS_API_KEY=                               # EVM token security audit
UNISWAP_API_KEY=your_uniswap_api_key_here     # EVM/Robinhood swap entry
JUPITER_API_KEY=your_jupiter_api_key_here     # Solana swap quotes (higher rate limits)
RUGCHECK_API_URL=https://api.rugcheck.xyz/v1  # Solana security audit

# ─── Trading Private Keys (KEEP DRY_RUN=true during testing!) ────────────────
SOLANA_PRIVATE_KEY=
EVM_PRIVATE_KEY=
HYPERLIQUID_PRIVATE_KEY=

# ─── Execution Tuning ─────────────────────────────────────────────────────────
SOLANA_PRIORITY_FEE_MICRO=0                   # per-CU priority fee (micro-lamports)
EVM_PRIORITY_FEE_GWEI=0
SIMULATION_BALANCE_SOL=10.0                   # simulated wallet balances (DRY_RUN)
SIMULATION_BALANCE_ETH=1.0
SIMULATION_BALANCE_HYPERLIQUID=1000.0
SIMULATION_BALANCE_POLYMARKET=500.0

# ─── REST API ─────────────────────────────────────────────────────────────────
API_PORT=3000                                # Athena REST API (health + analytics)
