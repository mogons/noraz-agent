# Environment Variables Configuration for Athena Crypto Agent

# General Setup
NODE_ENV=development
DRY_RUN=true
LOG_LEVEL=info

# Discord Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Telegram Credentials (Optional - For Dual Platform Discord + Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Channel IDs
DISCORD_CHANNEL_CONTROL_ROOM=000000000000000000
DISCORD_CHANNEL_MEME_SOLANA=000000000000000000
DISCORD_CHANNEL_MEME_EVM=000000000000000000
DISCORD_CHANNEL_PERPS=000000000000000000
DISCORD_CHANNEL_NFT=000000000000000000

# Blockchain RPC Endpoints
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com
EVM_BASE_RPC_URL=https://mainnet.base.org
EVM_ETH_RPC_URL=https://eth.llamarpc.com
EVM_ROBINHOOD_RPC_URL=https://rpc.robinhood.com

# AI Engine Credentials (Adaptable & Stackable API Keys Backup Failover)
AI_PROVIDER=openrouter                      # Options: 'openrouter' | 'openai' | 'anthropic' | 'custom'
AI_BASE_URL=https://openrouter.ai/api/v1   # Base URL for custom endpoints (9router, GLM, local vLLM, etc.)
AI_API_KEYS=key_primary_123,key_backup_456,key_backup_789  # Stack multiple API keys (comma-separated) for automatic backup failover!
AI_API_KEY=your_llm_api_key_here
AI_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free # e.g. claude-3-5-sonnet-20241022, gpt-4o, glm-4

# Per-Key AI Provider Config (OPTIONAL — Primary & Backup boleh beda provider!)
# Slot 1 = Primary key (pakai AI_PROVIDER/AI_BASE_URL/AI_MODEL_NAME di atas)
# Slot 2..6 = backup keys sesuai urutan AI_API_KEYS (key ke-2, ke-3, ...)
# Bila AI_KEY_N_* tidak diisi, backup memakai konfigurasi Primary (perilaku lama).
AI_KEY_2_PROVIDER=
AI_KEY_2_BASE_URL=
AI_KEY_2_MODEL_NAME=
AI_KEY_3_PROVIDER=
AI_KEY_3_BASE_URL=
AI_KEY_3_MODEL_NAME=

# Security Audit & Market Intelligence API Keys
TWEX_API_KEY=your_twex_api_key_here          # X/Twitter Scraping API (https://twexapi.io)
OPENSEA_API_KEY=your_opensea_api_key_here
# GMGN AI OpenAPI (https://openapi.gmgn.ai) — 4 endpoints used by meme-solana screener:
#   /v1/market/rank        (top gainers by interval: 1m/5m/1h/6h/24h)
#   /v1/trenches           (new_creation / near_completion / completed pump cohorts)
#   /v1/market/token_signal (token signal events: e.g. signal_type 2 = big buy by smart money)
#   /v1/market/hot_searches (hot searched tokens)
# Auth: X-APIKEY header; 429 rate-limited with auto-retry. DexScreener fallback if unset.
GMGN_API_KEY=your_gmgn_api_key_here
GOPLUS_API_KEY=
# Uniswap Trade API (https://trade-api.gateway.uniswap.org/v1) — EVM/Robinhood swap entry
UNISWAP_API_KEY=your_uniswap_api_key_here
# Jupiter API (https://api.jup.ag) — optional, higher rate limits for Solana swap quotes
JUPITER_API_KEY=your_jupiter_api_key_here
RUGCHECK_API_URL=https://api.rugcheck.xyz/v1

# Trading Private Keys (Keep DRY_RUN=true during testing!)
SOLANA_PRIVATE_KEY=
EVM_PRIVATE_KEY=
