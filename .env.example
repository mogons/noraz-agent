# Environment Variables Configuration for Athena Crypto Agent
# Copy this file to .env and fill in your credentials. NEVER commit .env.

# ─── General Setup ───────────────────────────────────────────────────────────
DRY_RUN=true                                  # true = safe simulation (default); false = LIVE TRADING
SCREENING_TIMEOUT_MS=60000                     # per-agent pass timeout (ms); stuck pass resolves to [] (fail-closed)
AUTO_EXECUTE_ENABLED=false                     # default OFF: bot = screener/caller only, execution 100% manual. Flip true untuk auto-execute.
GMGN_REQUEST_SPACING_MS=300                    # min delay (ms) between GMGN API calls (rate-limit safety)

# ─── Discord Credentials ─────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CHANNEL_CONTROL_ROOM=000000000000000000   # #athena-control-room (command center)

# ─── Telegram Credentials (Optional — dual-platform) ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Blockchain RPC Endpoints (Robinhood Chain — EVM L2, chain ID 4663, native ETH) ──
EVM_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com   # canonical Robinhood Chain RPC
EVM_RPC_URL=https://rpc.mainnet.chain.robinhood.com             # generic EVM fallback RPC
# RPC failover pool (JSON): {"evm": ["url1","url2"]}
RPC_FAILOVER_URLS={"evm":["https://rpc.mainnet.chain.robinhood.com"]}

# ─── AI Engine (stackable keys + per-key provider failover) ──────────────────
AI_PROVIDER=openrouter                      # 'openrouter' | 'openai' | 'anthropic' | 'custom'
AI_BASE_URL=https://openrouter.ai/api/v1    # custom endpoint base URL
AI_API_KEYS=key_primary_123,key_backup_456  # comma-separated — automatic backup failover
AI_API_KEY=your_llm_api_key_here
AI_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
# Per-key provider overrides (slot 2+): AI_KEY_<N>_PROVIDER / _BASE_URL / _MODEL_NAME
AI_KEY_2_PROVIDER=
AI_KEY_2_BASE_URL=
AI_KEY_2_MODEL_NAME=
AI_KEY_3_PROVIDER=
AI_KEY_3_BASE_URL=
AI_KEY_3_MODEL_NAME=

# ─── Market Intelligence & Security APIs ─────────────────────────────────────
TWEX_API_KEY=your_twex_api_key_here           # X/Twitter social intelligence (sentiment scoring)
TWITTER_BEARER_TOKEN=                         # alternative Twitter API bearer
TWITTER_TOKEN=                                # OpenTwitter (6551.io/mcp, gratis) — profil/KOL followers/search engagement; sumber utama Twitter
GMGN_API_KEY=your_gmgn_api_key_here           # GMGN OpenAPI (smart-money / rank / trenches / token security audit)
GMGN_API_KEY_ROBINHOOD=                       # Opsional: key GMGN terpisah untuk robinhood (rate limit per key)
OPENSEA_API_KEY=your_opensea_api_key_here     # NFT floor/rarity + swap aggregator (nft agent)
GOPLUS_API_KEY=your_goplus_api_key_here       # EVM token security audit (Robinhood Chain)
UNISWAP_API_KEY=your_uniswap_api_key_here     # Uniswap Trade API — Robinhood/EVM swap entry
# Krystal Cloud DeFi Data API (https://cloud.krystal.app) — LP pool data robinhood chain (ethereum@4663); mandatory untuk LP robinhood agent
KRYSTAL_CLOUD_API_KEY=your_krystal_cloud_api_key_here

# ─── Trading Private Keys (KEEP DRY_RUN=true during testing!) ────────────────
EVM_PRIVATE_KEY=your_evm_private_key_here

# ─── Execution Tuning ─────────────────────────────────────────────────────────
EVM_PRIORITY_FEE_GWEI=0
SIMULATION_BALANCE_ETH=1.0                    # simulated wallet balance (DRY_RUN)

# ─── REST API ─────────────────────────────────────────────────────────────────
API_PORT=3000                                # Athena REST API (health + analytics)
